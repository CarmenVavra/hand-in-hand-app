# Vorlage für deploy.sh – kopieren nach .deploy.env (wird nicht eingecheckt)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
# App-Ordner auf dem Server; der Webserver-Dokumentenstamm muss auf <DEPLOY_PATH>/public zeigen
DEPLOY_PATH=httpdocs
# PHP-Programm auf dem Server (bei netcup/Plesk oft versionsspezifisch, z. B. /opt/plesk/php/8.3/bin/php)
DEPLOY_PHP=php
# Optional: Pfad zum privaten SSH-Schlüssel
DEPLOY_SSH_KEY=
# Optional: öffentliche Adresse für den Health-Check nach dem Deployment
DEPLOY_URL=
